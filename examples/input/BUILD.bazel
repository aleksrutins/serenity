load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")

package(default_visibility = ["//visibility:public"])

INPUT_CPP = preprocess_cpp_files("example_input_cpp", ["main.cpp"])
INPUT_HDRS = preprocess_cpp_files("example_input_hdr", glob(["*.hpp"]))

cc_binary(
    name = "serenity-example-input",
    srcs = INPUT_CPP + INPUT_HDRS,
    copts = [
        "-DSMILEY_PATH=\\\"examples/input/smiley.bmp\\\"",
        "-Ofast",
        "-std=c++20",
    ],
    data = ["smiley.bmp"],
    includes = ["preprocessed"],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//input:serenity-input",
    ],
)
