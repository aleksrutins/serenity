    srcs = ["main.cpp"] + glob(["*.hpp"]),
    includes = ["."],
    copts = ["-DSMILEY_PATH=\\\"examples/input/smiley.bmp\\\"", "-fext-numeric-literals", "-Ofast", "-std=c++20"],
