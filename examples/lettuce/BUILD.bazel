load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")

package(default_visibility = ["//visibility:public"])

LETTUCE_CPP = preprocess_cpp_files("lettuce_cpp", ["main.cpp"])

cc_binary(
    name = "serenity-example-lettuce",
    srcs = LETTUCE_CPP,
    copts = [
        "-DLETTUCE_PATH=\\\"examples/lettuce/lettuce.bmp\\\"",
        "-Ofast",
        "-std=c++20",
    ],
    data = ["lettuce.bmp"],
    includes = ["."],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
    ],
)
