load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "serenity-example-camera",
    srcs = ["main.cpp"] + glob(["*.hpp"]),
    copts = [
        "-DSMILEY_PATH=\\\"examples/camera/smiley.bmp\\\"",
        "-Ofast",
        "-std=c++20",
    ],
    data = ["smiley.bmp"],
    includes = ["."],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//input:serenity-input",
    ],
)
