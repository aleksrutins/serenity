load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "serenity",
    srcs = ["main.cpp"] + glob(["**/*.hpp"]),
    includes = ["."],
    copts = ["-Ofast", "-std=c++20"],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//input:serenity-input",
        "//modules/SDL3:SDL3",
        "//modules/lua5.4:lua",
        "//modules/sol2:sol2",
    ],
)

exports_files(["runtime_test.lua"])