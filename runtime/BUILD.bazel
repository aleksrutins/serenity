load("@rules_cc//cc:defs.bzl", "cc_binary")
load(":bindings.bzl", "lua_binding")

package(default_visibility = ["//visibility:public"])

lua_binding("math")

lua_binding("core")

lua_binding("graphics")

lua_binding("2d")

lua_binding("input")

cc_binary(
    name = "serenity",
    srcs = [
        "main.cpp",
        ":2d_binding",
        ":core_binding",
        ":graphics_binding",
        ":input_binding",
        ":math_binding",
    ] + glob(["**/*.hpp"]),
    copts = [
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["."],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//input:serenity-input",
        "//modules/SDL3",
        "//modules/lua5.4:lua",
        "//modules/sol2",
    ],
)

exports_files(["runtime_test.lua"])
