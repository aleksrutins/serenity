load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")
load(":bindings.bzl", "lua_binding")

package(default_visibility = ["//visibility:public"])

lua_binding("math")

lua_binding("core")

lua_binding("graphics")

lua_binding("2d")

lua_binding("input")

lua_binding("gui")

RUNTIME_CPP = preprocess_cpp_files(
    "runtime_cpp",
    ["main.cpp"],
)

RUNTIME_HDRS = preprocess_cpp_files(
    "runtime_hdr",
    glob(["**/*.hpp"]),
)

cc_binary(
    name = "serenity",
    srcs = RUNTIME_CPP + [
        ":2d_binding_preprocessed",
        ":core_binding_preprocessed",
        ":graphics_binding_preprocessed",
        ":gui_binding_preprocessed",
        ":input_binding_preprocessed",
        ":math_binding_preprocessed",
    ] + RUNTIME_HDRS,
    copts = [
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["preprocessed"],
    deps = [
        "//2d:serenity-2d",
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//input:serenity-input",
        "//modules/SDL3",
        "//modules/lua5.4:lua",
        "//modules/sol2",
        "@imgui",
    ],
)

exports_files(["runtime_test.lua"])
