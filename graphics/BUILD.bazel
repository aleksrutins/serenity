load("@rules_cc//cc:defs.bzl", "cc_library")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")

package(default_visibility = ["//visibility:public"])

GRAPHICS_SRCS = preprocess_cpp_files("graphics_src", ["renderer.cpp"])
GRAPHICS_HDRS = preprocess_cpp_files("graphics_hdr", glob(["include/**/*.hpp"]))

cc_library(
    name = "serenity-graphics",
    srcs = GRAPHICS_SRCS,
    hdrs = GRAPHICS_HDRS,
    copts = [
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["preprocessed/include"],
    deps = [
        "//core:serenity",
        "//modules/SDL3",
        "//sup",
    ],
)
