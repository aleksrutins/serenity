load("@rules_cc//cc:defs.bzl", "cc_library")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")

package(default_visibility = ["//visibility:public"])

TWO_D_SRCS = preprocess_cpp_files("two_d_src", [
    "camera.cpp",
    "collisionbox.cpp",
    "painter.cpp",
    "platformerphysics.cpp",
    "sprite.cpp",
    "spritesheet.cpp",
    "transform.cpp",
])
TWO_D_HDRS = preprocess_cpp_files("two_d_hdr", glob(["include/**/*.hpp"]))

cc_library(
    name = "serenity-2d",
    srcs = TWO_D_SRCS,
    hdrs = TWO_D_HDRS,
    copts = [
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["preprocessed/include"],
    deps = [
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//modules/SDL3",
        "//modules/SDL3_image",
        "//modules/SDL3_ttf",
        "//sup",
    ],
)
