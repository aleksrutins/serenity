load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "serenity-2d",
    srcs = [
        "camera.cpp",
        "collisionbox.cpp",
        "painter.cpp",
        "platformerphysics.cpp",
        "sprite.cpp",
        "spritesheet.cpp",
        "transform.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = [
        "-Icore/include",
        "-Igraphics/include",
        "-I2d/include",
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["include"],
    deps = [
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//modules/SDL3",
        "//modules/SDL3_image",
        "//modules/SDL3_ttf",
        "//sup",
    ],
)
