load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "serenity-2d",
    hdrs = glob(["include/**/*.hpp"]),
    srcs = ["camera.cpp", "collisionbox.cpp", "painter.cpp", "platformerphysics.cpp", "sprite.cpp", "spritesheet.cpp", "transform.cpp"],
    includes = ["include"],
    copts = ["-Icore/include", "-Igraphics/include", "-I2d/include", "-Ofast", "-std=c++20"],
    deps = [
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//modules/SDL3:SDL3",
        "//modules/SDL3_image:SDL3_image",
        "//modules/SDL3_ttf:SDL3_ttf",
        "//modules/sup:sup",
    ],
)