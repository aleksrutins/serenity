load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gtk4",
    linkopts = ["-lgtk-4"],
)

cc_library(
    name = "libadwaita",
    linkopts = ["-ladwaita-1"],
    deps = [":gtk4"],
)

cc_library(
    name = "qt6",
    copts = [
        "-I/usr/include/qt6",
        "-I/usr/include/qt6/QtWidgets",
        "-I/usr/include/qt6/QtGui",
        "-I/usr/include/qt6/QtCore",
        "-DQT_WIDGETS_LIB",
        "-DQT_GUI_LIB",
        "-DQT_CORE_LIB",
    ],
    linkopts = [
        "-lQt6Widgets",
        "-lQt6Gui",
        "-lQt6Core",
    ],
)
