load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

cmake(
    name = "SDL3_ttf",
    lib_source = "@sdl3_ttf_src//:all",
    cache_entries = {
        "SDLTTF_VENDORED": "OFF",
        "SDLTTF_TESTS": "OFF",
    },
    env = {"CFLAGS": "-std=gnu17"},
    out_include_dir = "include",
    out_interface_libs = select({
        "@bazel_tools//src/conditions:windows": ["SDL3_ttf.lib"],
        "//conditions:default": []
    }),
    out_shared_libs = select({
        "@bazel_tools//src/conditions:darwin": ["libSDL3_ttf.0.dylib"],
        "@bazel_tools//src/conditions:linux": ["libSDL3_ttf.so.0"],
        "@bazel_tools//src/conditions:windows": ["SDL3_ttf.dll"]
    }),
    deps = ["//modules/SDL3:SDL3"],
)