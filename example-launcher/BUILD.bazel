load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "serenity-example-launcher",
    srcs = ["main.cpp"],
    copts = [
        "-I/usr/include/qt6",
        "-I/usr/include/qt6/QtWidgets",
        "-I/usr/include/qt6/QtGui",
        "-I/usr/include/qt6/QtCore",
        "-DQT_WIDGETS_LIB",
        "-DQT_GUI_LIB",
        "-DQT_CORE_LIB",
        "-std=c++20",
    ],
    deps = ["//modules/gtk:qt6"],
)

exports_files(["image-missing.svg"])