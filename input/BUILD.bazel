    copts = ["-Icore/include", "-Igraphics/include", "-Iinput/include", "-Ofast", "-std=c++20"],
    deps = ["//core:serenity", "//graphics:serenity-graphics", "//modules/SDL3:SDL3", "//modules/sup:sup"],
