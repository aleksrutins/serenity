load("@rules_cc//cc:defs.bzl", "cc_library")
load("//codegen:preprocess.bzl", "preprocess_cpp_files")

package(default_visibility = ["//visibility:public"])

INPUT_SRCS = preprocess_cpp_files("input_src", ["keyboard.cpp"])
INPUT_HDRS = preprocess_cpp_files("input_hdr", glob(["include/**/*.hpp"]))

cc_library(
    name = "serenity-input",
    srcs = INPUT_SRCS,
    hdrs = INPUT_HDRS,
    copts = [
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["preprocessed/include"],
    deps = [
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//modules/SDL3",
        "//sup",
    ],
)
