load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "serenity-input",
    srcs = ["keyboard.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    copts = [
        "-Icore/include",
        "-Igraphics/include",
        "-Iinput/include",
        "-Ofast",
        "-std=c++20",
    ],
    includes = ["include"],
    deps = [
        "//core:serenity",
        "//graphics:serenity-graphics",
        "//modules/SDL3",
        "//sup",
    ],
)
